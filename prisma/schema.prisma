// Link Tomorrow - data model (ported from the reference PHP app).
// Money is stored as integer USD cents everywhere.
//
// LOCAL DEV uses SQLite (works with zero setup).
// PRODUCTION: change `provider` to "postgresql" and set DATABASE_URL to your
// Postgres connection string (Neon / Supabase / AWS RDS), then run
// `npx prisma migrate deploy`. Enums are modelled as strings so the schema is
// portable between SQLite and Postgres without changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("buyer") // buyer | publisher | admin
  balanceCents   Int      @default(0)   // buyer wallet
  withdrawnCents Int      @default(0)   // publisher: total already paid out
  payoutBank     String?  // legacy free-text payout note
  payMethod      String?  // bank | paypal | mpesa | card
  payCountry     String?
  payBank        String?  // bank name + account
  payPaypal      String?  // PayPal email
  payMpesa       String?  // M-Pesa phone
  payCard        String?  // card / other note
  tuesdayAgreed  Boolean  @default(false) // publisher accepted the payout terms
  verified       Boolean  @default(false)
  // FOUNDING BUYERS. The first FOUNDER_BUYER_LIMIT buyers ever to sign up see
  // the whole marketplace with no deposit, for life. The slot number (1..10) is
  // stored rather than worked out from createdAt on the fly, so the group can
  // never shift when a row is deleted, and @unique is what actually stops two
  // simultaneous signups claiming the same slot.
  founderNumber  Int?     @unique
  // PUBLISHER BROUGHT IN BY A BUYER. Set when a publisher registers through a
  // link generated from that buyer's site request. Every site this publisher
  // lists is then priced at the inviting buyer's negotiated rate - the flat
  // brought-in commission, for as long as they keep buying. See
  // lib/requester.ts and broughtInFee() in lib/money.ts.
  invitedByBuyerId Int?
  // Demo accounts. A demo buyer only ever sees demo listings, and a real buyer
  // never sees one. Used for showing the platform without touching live
  // inventory or letting a prospect place a real order.
  isDemo         Boolean  @default(false)
  // SIMULATED BUYER. A real buyer account in every respect - real login, real
  // marketplace, real orders, real publisher payouts - except that its balance
  // was credited by an admin instead of paid by card. Used for the accounts we
  // buy placements on ourselves. Everything it spends is reported separately on
  // Admin -> Simulated accounts and kept out of the real revenue totals,
  // because that money never existed.
  isSimulated    Boolean  @default(false)
  // PUBLISHER PAYOUT METHOD REVIEW. PayPal is approved on sight. Anything else
  // is a request: "pending" until an admin says whether we can pay that way,
  // and the publisher is promised an answer within 24 hours.
  payStatus      String   @default("approved") // approved | pending | rejected
  payNote        String?  // the admin's answer, shown to the publisher
  payRequestedAt DateTime?
  // Invoice instead of stored details: this publisher sends an invoice with
  // every live URL rather than being paid to details held on file.
  payInvoiceMode Boolean  @default(false)
  // Every session token carries this number. Bumping it ends every session
  // the user has, on every device: sign-out and password reset both do.
  sessionVersion Int      @default(0)
  // BUYER APPROVAL. A buyer who signs up on the public form is "pending" and
  // cannot sign in until an admin approves them on Admin -> Users. The default
  // is "approved" so every other account (publishers, admins, simulated, demo,
  // and every buyer from before this column existed) is unaffected.
  approvalStatus String   @default("approved") // approved | pending | rejected
  createdAt      DateTime @default(now())

  listings  Listing[]
  orders    Order[]    @relation("BuyerOrders")
  walletTx  WalletTx[]
  simulatedCredits SimulatedCredit[]
  withdrawals Withdrawal[]
}

model Listing {
  id             Int      @id @default(autoincrement())
  publisherId    Int
  publisher      User     @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  domain         String
  url            String
  category       String   // comma-separated niches
  country        String
  language       String   @default("English")
  domainRating   Int       @default(0) // Ahrefs DR. Always fetched, even when DA is displayed.
  monthlyTraffic Int       @default(0) // publisher-entered monthly organic visits - NOT fetched
  metricsUpdatedAt DateTime? // last time DR was fetched from Ahrefs
  // Which authority number buyers see for this site. Some sites score poorly on
  // Ahrefs DR but well on Moz DA, so a publisher may choose to show DA instead.
  // We are not connected to Moz, so DA is a publisher-supplied claim - which is
  // exactly why domainRating above is still fetched and kept for admins.
  authorityType   String   @default("dr") // "dr" (Ahrefs, automatic) | "da" (publisher-entered)
  domainAuthority Int      @default(0)    // only meaningful when authorityType = "da"
  // The number actually on display, denormalised so the marketplace can filter
  // and the home page can rank in one indexed query. Postgres cannot ORDER BY a
  // value that depends on another column's contents, so this is kept in step by
  // authorityFor() in lib/authority.ts - never set it by hand.
  authorityScore  Int      @default(0)
  // Which buyer-pricing rule applies. Sites listed before the tiered pricing
  // launch keep "flat30" (+$30) for life; everything new is created as "tiered".
  markupModel    String   @default("flat30")
  // Sites a buyer brought in: that buyer pays the flat brought-in commission,
  // everyone else pays the standard tiered margin.
  requestedById  Int?
  siteRequestId  Int?
  vatPercent     Float    @default(0) // added to the publisher price before any margin
  linkType       String   @default("guest_post") // guest_post | niche_edit
  priceCents     Int      @default(0) // publisher's price (what they receive), in cents
  tatDays        Int      @default(7)
  description    String?
  status         String   @default("pending") // pending | approved | rejected
  // Demo inventory. Shown only to demo accounts, and hidden from everyone else.
  // Indexed because every buyer-facing listing query now filters on it.
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())

  orders Order[]

  @@index([status])
  @@index([isDemo])
  @@index([publisherId])
  @@index([authorityScore])
}

model Order {
  id             Int      @id @default(autoincrement())
  buyerId        Int
  buyer          User     @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  listingId      Int
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  targetUrl      String?
  anchorText     String?
  notes          String?
  articleContent String?  // pasted guest-post content / instructions
  featuredImage  String?  // uploaded featured image (data URL) or link
  articleDocName String?  // uploaded guest-post document filename
  articleDocUrl  String?  // uploaded guest-post document (data URL)
  turnaroundDays Int      @default(7) // buyer-selected turnaround: 5 | 7 | 10
  // What the buyer is sending: a guest post or a PR article. Chosen at checkout.
  contentType    String   @default("guest_post") // guest_post | pr_article
  liveUrl        String?
  amountCents    Int      @default(0) // what the buyer pays
  payoutCents    Int      @default(0) // what the publisher receives
  commissionRate String   @default("0")
  status         String   @default("pending_payment") // pending_payment | funded | in_progress | live | completed | cancelled
  publisherPaid  Boolean  @default(false)
  // Turnaround deadline. Set the moment the order is funded (createdAt is no
  // use - an order can sit unpaid for days). The clock stops when the publisher
  // submits the live URL; anything still funded or in progress past this
  // instant is cancelled automatically and the buyer refunded.
  // Null means no deadline: orders funded before this feature shipped.
  dueAt          DateTime?
  cancelReason   String?   // why it was cancelled, in the canceller's own words
  // How much actually went back to the buyer's balance. 0 for an order that was
  // cancelled before it was ever paid for, so the UI never claims a refund that
  // never happened.
  refundedCents  Int      @default(0)
  cancelledBy    String?   // buyer | publisher | admin | system
  cancelledAt    DateTime?
  // Publishers on invoice terms attach one with the live URL. Held as a link,
  // which is what they asked for: they send an invoice each time rather than
  // keeping payment details on file.
  invoiceName    String?
  invoiceUrl     String?
  // The withdrawal request this order's payout is part of. Set when the
  // publisher presses Withdraw, cleared again if an admin declines it, so the
  // same payout can never sit in two requests at once.
  withdrawalId   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([buyerId])
  @@index([withdrawalId])
  @@index([listingId])
  @@index([status])
  @@index([dueAt])
}

// A publisher asking to be paid what they have earned.
//
// The publisher presses Withdraw, confirms where the money should go, and every
// completed order not yet paid is attached to the request. An admin then either
// pays it (the orders are marked paid) or declines it with a reason (the orders
// are released so they can be asked for again). The payment details are copied
// onto the request, so what the admin paid to stays on record even if the
// publisher changes their saved details later.
model Withdrawal {
  id          Int       @id @default(autoincrement())
  publisherId Int
  publisher   User      @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  amountCents Int       @default(0)
  method      String    @default("paypal") // paypal | mpesa | bank | other
  details     String    @default("")
  country     String?
  status      String    @default("pending") // pending | paid | rejected
  adminNote   String?   // shown to the publisher
  reference   String?   // the admin's payment reference, e.g. a PayPal transaction id
  decidedById Int?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([publisherId])
  @@index([status])
}

model WalletTx {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String   // topup | spend | refund
  amountCents Int
  method     String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// An admin crediting a simulated buyer account.
//
// Kept as its own table rather than as another WalletTx kind for one reason:
// the report has to separate money that was never real from money that was, and
// WalletTx only stores the net figure with the gross buried in a text note. The
// buyer still gets an ordinary WalletTx row as well, so their wallet history
// looks exactly like anyone else's.
model SimulatedCredit {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grossCents  Int      @default(0) // what a real buyer would have paid
  feeCents    Int      @default(0) // the 5% service fee, withheld exactly as usual
  netCents    Int      @default(0) // what landed on the balance
  note        String?
  createdById Int      @default(0) // the admin who added it
  createdAt   DateTime @default(now())

  @@index([userId])
}

model StripeTx {
  id         Int      @id @default(autoincrement())
  ref        String   @unique
  userId     Int
  purpose    String   // order | topup
  orderId    Int      @default(0)
  amountCents Int
  status     String   @default("pending") // pending | success | failed
  providerId String?
  createdAt  DateTime @default(now())
}

model Invite {
  id         Int       @id @default(autoincrement())
  email      String?
  token      String    @unique
  role       String    @default("publisher")
  expiresAt  DateTime
  acceptedAt DateTime?
  // A link generated from a buyer's site request. The buyer sends it to the
  // publisher they negotiated with; whoever registers through it is attributed
  // to this buyer, and that buyer gets their negotiated rate on the sites that
  // publisher lists. Null on an ordinary invite.
  requestedById Int?
  siteRequestId Int?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// A buyer asking us to list a publisher they have negotiated with themselves.
// On approval this becomes a Listing priced two ways: the requesting buyer pays
// their negotiated price plus 5%, every other buyer pays the standard margin.
model SiteRequest {
  id              Int      @id @default(autoincrement())
  buyerId         Int
  siteName        String
  domain          String
  negotiatedCents Int      @default(0) // price agreed with the publisher
  publisherName   String?
  publisherEmail  String?
  publisherPhone  String?
  tatDays         Int      @default(7)
  category        String   @default("General")
  country         String   @default("Kenya")
  language        String   @default("English")
  linkType        String   @default("guest_post")
  vatApplies      Boolean  @default(false)
  vatPercent      Float    @default(0)
  agreed72h       Boolean  @default(false) // publisher accepted 72-hour payment
  agreedFee       Boolean  @default(false) // buyer accepted the 5% platform fee
  payMethod       String   @default("paypal") // paypal | bank | mpesa | other
  payDetails      String?
  notes           String?
  // pending  - awaiting review
  // invited  - a publisher link was generated and sent to the buyer
  // approved - listed directly by an admin, without a link
  // rejected
  status          String   @default("pending")
  adminNote       String?
  listingId       Int?
  inviteToken     String?  // the publisher link generated for this request
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([buyerId])
  @@index([status])
}

model PasswordReset {
  token     String   @id
  userId    Int
  expiresAt DateTime
}

model EmailVerification {
  token     String   @id
  userId    Int
  code      String   @default("") // 6-digit confirmation code the user types in
  attempts  Int      @default(0)  // wrong-code guesses, to stop brute forcing
  expiresAt DateTime
}

model Setting {
  key   String @id
  value String?
}

// Public "request to be a publisher" applications, reviewed by admins.
model PublisherApplication {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  urls      String   // newline/comma-separated list of website URLs for review
  note      String?
  status    String   @default("new") // new | reviewing | approved | rejected
  createdAt DateTime @default(now())

  @@index([status])
}

// Attempt counters for sign-in, codes, resets, sign-ups and the public forms.
// One row per key ("login:email:someone@x.com", "login:ip:1.2.3.4"), reset when
// its window runs out. See lib/rate-limit.ts.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// Who did what in the admin area. Written for every action that moves money,
// changes who can do what, or deletes something. Never updated or deleted by
// the app. See lib/audit.ts.
model AdminAudit {
  id         Int      @id @default(autoincrement())
  adminId    Int
  adminEmail String
  action     String
  target     String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}
