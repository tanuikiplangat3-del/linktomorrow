// Cloudflare Worker settings for Link Tomorrow (moved from AWS ECS, Nov 2026).
// Secrets (database password, Stripe, Resend, Ahrefs, AUTH_SECRET...) are NOT
// here. They are stored in Cloudflare with `wrangler secret`, copied once from
// the old ECS task definition.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linktomorrow",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // Tells instrumentation.ts not to start the old in-app timers.
    "RUNTIME": "cloudflare"
  },
  // Cloudflare's connection pool in front of the Supabase database.
  // Created with caching OFF: cached reads would show stale balances and orders.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ef822f2b2d714bbeb085c05eca6d533d",
      "localConnectionString": "postgresql://postgres:local@localhost:55432/lt"
    }
  ],
  // The test address https://linktomorrow.cosmas-569.workers.dev/linktomorrow
  // stays on for checks. It uses the same live database.
  "workers_dev": true,
  // The live address (switched from AWS on cutover, Nov 2026). Only the
  // /linktomorrow path: everything else on tools.welcometomorrow.io is untouched.
  "routes": [
    { "pattern": "tools.welcometomorrow.io/linktomorrow*", "zone_name": "welcometomorrow.io" }
  ],
  // Background jobs (see worker.ts): turnaround auto-cancel every 5 minutes,
  // Domain Rating refresh every 6 hours. These replace the AWS in-app timers.
  "triggers": { "crons": ["*/5 * * * *", "17 */6 * * *"] },
  // Runs the Worker close to the database (Supabase, Ireland) rather than next
  // to each visitor, because most pages make several database queries.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
